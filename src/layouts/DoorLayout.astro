---
import { css, cx } from 'styled-system/css';
import * as s from '@/console/styles';
import ScrollRuler from '@/components/ScrollRuler.astro';

export interface Props {
  n: string;
  title: string;
  lede?: string;
  archive?: boolean;
  metas: { label: string; value: string; href?: string }[];
  prev?: { href: string; n: string; label: string; title: string; locked?: boolean };
  next?: { href: string; n: string; label: string; title: string; locked?: boolean };
}

const { n, title, lede, archive = false, metas, prev, next } = Astro.props;
const numeralTile = css({ display: 'flex', flexDir: 'column', justifyContent: 'space-between', gap: '12px' });
const titleTile = css({ display: 'flex', flexDir: 'column', justifyContent: 'flex-end', gap: '16px', pt: '36px' });
const navGrid = css({ display: 'grid', gap: '1px', gridTemplateColumns: 'repeat(auto-fit, minmax(min(260px, 100%), 1fr))' });
const navNum = css({ fontSize: '44px' });
const navInner = css({ display: 'flex', alignItems: 'center', gap: '18px' });
const neighbours = [prev, next].filter((door) => door !== undefined);
---

<section class={s.g3}>
  <div class={cx(s.tile({ tone: archive ? 'readout' : 'read' }), numeralTile)}>
    <span data-label class={s.label}>{archive ? '2025 edition' : '2026 edition'}</span>
    <span class={cx(s.digits, s.hugeNum)} aria-hidden="true">{n.split('').map((char) => <span>{char}</span>)}</span>
  </div>
  <div class={cx(s.tile(), s.s2, titleTile)}>
    <h1 class={s.h1}>{title}</h1>
    {lede && <p class={s.lede}>{lede}</p>}
  </div>
  {
    metas.map((meta) =>
      meta.href ? (
        <a href={meta.href} data-key class={s.key({ pad: true, row: true })}>
          <span class={s.col}>
            <span data-label class={s.label}>{meta.label}</span>
            <span class={s.val}>{meta.value}</span>
          </span>
          <svg data-arrow aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9h12M10 4l5 5-5 5" />
          </svg>
        </a>
      ) : (
        <div class={cx(s.tile({ tone: 'readout' }), s.col)}>
          <span data-label class={s.label}>{meta.label}</span>
          <span class={s.val}>{meta.value}</span>
        </div>
      )
    )
  }
</section>

<slot />

<ScrollRuler />

{
  neighbours.length > 0 && (
    <nav aria-label="Doors" class={navGrid}>
      {neighbours.map((door) => (
        <a href={door.href} data-key class={s.key({ pad: true, tone: door.locked ? 'locked' : door === next ? 'today' : 'plain' })}>
          <span class={navInner}>
            <span data-num class={cx(s.num, navNum)}>{door.n}</span>
            <span class={s.col}>
              <span data-label class={s.label}>{door.label}</span>
              <span class={s.h3}>{door.title}</span>
            </span>
          </span>
        </a>
      ))}
    </nav>
  )
}
