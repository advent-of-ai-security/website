---
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import Notice from '@/components/Notice.astro';
---

<ConsoleLayout title="Page not found" description="The page you're looking for doesn't exist." canonicalPath="/404" centered>
  <Notice
    figure="404"
    title="No door behind this one."
    text="The address does not match a door or a page. The calendar has ten, numbered 01 to 10."
    actions={[
      { href: '/', label: 'Go to the 2026 calendar', primary: true },
      { href: '/2025', label: 'Open the 2025 recap' },
    ]}
  />
</ConsoleLayout>
