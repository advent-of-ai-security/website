---
import ConsoleLayout from '@/layouts/ConsoleLayout.astro';
import Keypad from '@/components/Keypad.vue';
import { UNLOCK_ALL_DOORS } from 'astro:env/server';
import { doors2026, doorState, longDate } from '@/data/editions';

const siteName = 'Advent of AI Security';
const description = 'An Advent calendar of the OWASP Top 10 for LLM Applications 2026: one risk a day, each with a lab against a real model running in your browser.';
const now = new Date();

const doors = doors2026.map((door) => {
  const state = doorState(door.date, UNLOCK_ALL_DOORS, now);
  const opens = `Opens ${longDate(door.date).replace(/ \d{4}$/, '')} at 00:00 UTC.`;
  return state === 'locked'
    ? { n: door.n, title: 'Locked', blurb: opens, glyph: '', state, href: `/2026/${door.n}` }
    : { n: door.n, title: door.title, blurb: door.blurb, glyph: door.glyph, state, href: `/2026/${door.n}` };
});

const today = doors.find((d) => d.state === 'today');
const lastOpen = doors.filter((d) => d.state === 'open').at(-1);
const next = doors2026.find((door) => doorState(door.date, UNLOCK_ALL_DOORS, now) === 'locked');
const featured = (today ?? lastOpen ?? doors[0]!).n;
---

<ConsoleLayout
  title={`${siteName} 2026`}
  description={description}
  canonicalPath="/"
  edition="2026"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    url: new URL('/', Astro.site ?? Astro.url).toString(),
    description,
  }}
>
  <Keypad client:load doors={doors} featured={featured} nextDoor={next?.n ?? null} nextAt={next?.date.toISOString() ?? null} now={now.toISOString()} />
</ConsoleLayout>
